# ============================================================================
# SISTEMA TRIAJE - VARIABLES DE ENTORNO
# ============================================================================
# Copiar este archivo a .env y configurar con valores reales
# NO COMMITEAR EL ARCHIVO .env (está en .gitignore)
# ============================================================================

# ----------------------------------------------------------------------------
# POSTGRESQL
# ----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=soctriaje
DB_USER=soc_app
DB_PASSWORD=changeme_db_password_here
# Usuario admin para migraciones (con permisos DDL)
DB_ADMIN_USER=soc_admin
DB_ADMIN_PASSWORD=changeme_admin_password_here

# ----------------------------------------------------------------------------
# REDIS
# ----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# TTL de cache por proveedor (segundos)
REDIS_CACHE_TTL_VIRUSTOTAL=86400  # 24 horas
REDIS_CACHE_TTL_ABUSEIPDB=43200   # 12 horas
REDIS_CACHE_TTL_GEOIP=604800      # 7 días

# ----------------------------------------------------------------------------
# JWT Y AUTENTICACIÓN
# ----------------------------------------------------------------------------
JWT_SECRET_KEY=changeme_jwt_secret_key_min_32_chars_random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# BACKEND API
# ----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
# CORS: lista separada por comas
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
# API key para servicios internos (n8n)
SERVICE_API_KEY=changeme_service_api_key_for_n8n

# ----------------------------------------------------------------------------
# AI SERVICE (LANGCHAIN)
# ----------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001
# Proveedor de LLM: ollama (local, por defecto) o openai (exfiltra datos)
LLM_PROVIDER=ollama
# Ollama (local)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
# OpenAI (solo si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4
# Timeout del LLM (segundos)
LLM_TIMEOUT=30
# Sanitizar datos antes de enviar a APIs externas (true|false)
SANITIZE_EXTERNAL_DATA=false

# ----------------------------------------------------------------------------
# PROVEEDORES DE THREAT INTELLIGENCE
# ----------------------------------------------------------------------------
# VirusTotal
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT=10
# AbuseIPDB
ABUSEIPDB_API_KEY=
ABUSEIPDB_TIMEOUT=5
# GeoIP: usar MaxMind GeoLite2 (local) o ip-api.com (requiere internet)
GEOIP_PROVIDER=ip-api
GEOIP_MAXMIND_DB_PATH=/app/data/GeoLite2-City.mmdb
GEOIP_TIMEOUT=3

# ----------------------------------------------------------------------------
# n8n
# ----------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_password
N8N_PORT=5678
# Token secreto para validar webhooks
WEBHOOK_SECRET=changeme_webhook_secret_token

# ----------------------------------------------------------------------------
# NOTIFICACIONES
# ----------------------------------------------------------------------------
# Slack
ENABLE_SLACK=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Telegram
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# ----------------------------------------------------------------------------
# SISTEMAS DE TICKETING
# ----------------------------------------------------------------------------
ENABLE_TICKETING=false
TICKETING_SYSTEM=osticket  # osticket|redmine
# osTicket
OSTICKET_API_URL=http://mock-ticketing:1080/api/tickets.json
OSTICKET_API_KEY=changeme_osticket_api_key
# Redmine
REDMINE_API_URL=http://redmine.example.com
REDMINE_API_KEY=changeme_redmine_api_key
REDMINE_PROJECT_ID=soc-alerts

# ----------------------------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE_GET=100
RATE_LIMIT_PER_MINUTE_POST=20

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json|text

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=SistemaTriaje
VITE_AUTO_REFRESH_INTERVAL=30000  # milisegundos (30s)

# ----------------------------------------------------------------------------
# SEGURIDAD
# ----------------------------------------------------------------------------
# Bloqueo temporal tras intentos fallidos de login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
# Política de contraseñas (mínimos)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# ----------------------------------------------------------------------------
# DESARROLLO (no usar en producción)
# ----------------------------------------------------------------------------
DEBUG=false
# Deshabilitar verificación SSL (solo desarrollo)
DISABLE_SSL_VERIFY=false
